# Keystore configuration for Apparat release builds
# Copy this file to 'keystore.properties' (which is git-ignored) and fill in your values.
# Or set the equivalent environment variables: KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=release.keystore
storePassword=your_keystore_password
keyAlias=pocketknife_release_key
keyPassword=your_key_password
